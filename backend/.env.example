# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=replace-with-your-secret-key

# Relational Database (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cd_store
# For local testing without Postgres, uncomment below:
# DATABASE_URL=sqlite:///cd_store.db

# NoSQL Database (MongoDB for chat logs)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=cd_store_nosql

# AI / LLM API Configuration
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://api.example.com/v1/chat/completions

